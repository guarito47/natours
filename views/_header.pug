header.header
  nav.nav.nav--tours
    a.nav__el(href='/') All tours
  .header__logo
    img(src='/img/logo-white.png', alt='Natours logo')
  nav.nav.nav--user
    //-we use the pug 'if' we knowthat is not powerful as javascript but its enought in this case
    //-so we verify if exist the object user to make sure theres a user logged in
    if user
      a.nav__el.nav__el--logout Log out
      a.nav__el(href='/me')
        img.nav__user-img(src=`/img/users/${user.photo}`, alt=`photo of ${user.name}`)
        //- to show only the name and not the last name we split the string divided by space
        span= user.name.split(' ')[0]
    else
      a.nav__el(href='/login') Log in
      a.nav__el.nav__el--cta(href='# ') Sign up